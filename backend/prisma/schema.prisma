// Smart Parking System — Prisma schema (Area/Zone based)
// Konsep baru: parkir berbasis Area + kapasitas (bukan slot fisik per kendaraan).
// PostGIS tetap dipertahankan sebagai extension (tidak dipakai untuk polygon slot).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

enum Role {
  ADMIN
  JUKIR
  USER
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum AreaStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum TransactionStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  QRIS
}

enum ViolationStatus {
  PENDING
  VALID
  REJECTED
}

enum JukirStatus {
  ACTIVE
  INACTIVE
}

// Sumber laporan pelanggaran (sesuai konsep: User / Jukir / CCTV)
enum ViolationSource {
  USER
  JUKIR
  CCTV
}

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  passwordHash String
  role         Role       @default(USER)
  status       UserStatus @default(ACTIVE)
  
  // Jukir-specific fields (only populated if role = JUKIR)
  areaId       String?    // Assigned area for Jukir
  
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  transactionsAsJukir      Transaction[] @relation("TransactionJukir")
  transactionsAsCustomer   Transaction[] @relation("TransactionCustomer")
  violations               Violation[]
  areaJurik                ParkingArea? @relation("AreaJukirs", fields: [areaId], references: [id])
  setoranEntries           SetoranEntry[] @relation("SetoranJukir")
  approvedSetoran          SetoranEntry[] @relation("SetoranApprovedBy")
}

model ParkingArea {
  id          String     @id @default(uuid())
  name        String
  location    String // alamat / nama jalan area parkir
  vehicleType String     @default("motorcycle") // "motorcycle" | "car"
  capacity    Int // kapasitas ditentukan admin berdasarkan lapangan
  status      AreaStatus @default(ACTIVE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  jukirs       User[]         @relation("AreaJukirs")
  transactions Transaction[]
  detections   CvDetection[]
  violations   Violation[]
  setoranEntries SetoranEntry[] @relation("SetoranArea")
}


// Remove separate Jukir model - Jurik data now stored in User table with role=JUkIr + areaId
// Jukir fields are: role = 'JUkIR' and assigned areaId through User model

// Transaksi parkir masuk/keluar. QR merujuk ke transactionCode (bukan plat).
model Transaction {
  id              String            @id @default(uuid()) @db.Uuid
  transactionCode String            @unique // PARK-00001
  areaId          String            @db.VarChar(255)
  jukirId         String?           @db.VarChar(255)
  checkIn         DateTime          @default(now())
  checkOut        DateTime?
  durationMinutes Int?
  amount          Int? // tarif final setelah checkout
  paymentMethod   PaymentMethod? // diisi saat bayar (CASH / QRIS)
  paidAt          DateTime?
  status          TransactionStatus @default(ACTIVE)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@map("transaction")
  
  area    ParkingArea      @relation(fields: [areaId], references: [id], onDelete: Restrict)
  jukir   User?            @relation(fields: [jukirId], references: [id], onDelete: SetNull, name: "TransactionJukir")
  customer User?           @relation(fields: [userId], references: [id], name: "TransactionCustomer")
  userId  String?          @db.VarChar(255)
}

// Aturan MOU / pajak / bagian pengelola (configurable).
model MouRule {
  id              String    @id @default(uuid())
  name            String
  taxPercent      Float // persentase pajak / bagian pengelola dari revenue (%)
  operatorPercent Float     @default(0) // opsional: bagian operator/pengelola lain (%)
  jukirSharePercent Float   @default(15) // % bagian juru parkir dari revenue
  validFrom       DateTime
  validTo         DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// Hasil deteksi Computer Vision per area (bukan per slot).
model CvDetection {
  id            String   @id @default(uuid())
  areaId        String
  detectedAt    DateTime @default(now())
  emptyCount    Int      @default(0)
  occupiedCount Int      @default(0)
  illegalCount  Int      @default(0)
  source        String   @default("cctv") // "cctv" | "photo" | "video"
  createdAt     DateTime @default(now())

  area ParkingArea @relation(fields: [areaId], references: [id], onDelete: Cascade)
}

// Auto-calculated daily setoran/reporting untuk Jukir
enum SetoranStatus {
  PENDING
  APPROVED
  REJECTED
}

model SetoranEntry {
  id              String         @id @default(uuid())
  jukirId         String
  areaId          String
  date            DateTime       @default(now())
  
  totalTransactions Int          @default(0)  // Jumlah transaksi hari ini
  grossAmount       Int          @default(0)  // Total pendapatan sebelum dipotong
  
  taxPercent        Float        @default(0)  // Pajak dari mou rule (%)
  taxAmount         Int?                      // Pajak pengelola (amount)
  
  jukirSharePercent Float        @default(0)  // Persentase juru parkir dari mou rule
  jukirShareAmount  Int?                      // Amount yang jatuh ke juru parkir
  
  status            SetoranStatus @default(PENDING)
  approvedAt        DateTime?
  approvedBy        String?  // Admin user ID who approved
  adminNote         String?
  
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  jukir          User         @relation("SetoranJukir", fields: [jukirId], references: [id], onDelete: Cascade)
  area           ParkingArea  @relation("SetoranArea", fields: [areaId], references: [id], onDelete: Cascade)
  approvedByUser User?        @relation("SetoranApprovedBy", fields: [approvedBy], references: [id], onDelete: SetNull)
  
  @@index([jukirId, date])
  @@index([areaId, date])
  @@index([date])
}

model Violation {
  id            String          @id @default(uuid())
  photoPath     String // relative path served under /uploads
  areaId        String?
  violationType String          @default("illegal-parking")
  confidence    Float?
  source        ViolationSource @default(USER)
  reportedById  String?
  reporterRole  Role            @default(USER)
  status        ViolationStatus @default(PENDING)
  adminNote     String?
  detections    Json? // raw model output
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  area       ParkingArea? @relation(fields: [areaId], references: [id], onDelete: SetNull)
  reportedBy User?        @relation(fields: [reportedById], references: [id], onDelete: SetNull)
}
